## 🚀 كيفية الاستخدام

### إنشاء ترخيص جديد:

```pascal
// مثال لإنشاء ترخيص
var
  LicenseKey: string;
  Features: TStringArray;
begin
  SetLength(Features, 3);
  Features[0] := 'REPORTING';
  Features[1] := 'EXPORT';
  Features[2] := 'BACKUP';
  
  LicenseKey := CreateAndSaveLicense(
    'اسم العميل',
    'PROJ-A-2024',
    'FULL',
    IncYear(Now, 1),
    5,
    Features,
    'C:\Licenses\license.txt'
  );
end;
